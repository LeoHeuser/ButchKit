          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "आपकी ख़रीदारी से सब कुछ हमेशा के लिए अनलॉक हो जाता है। सब्सक्रिप्शन तब तक रिन्यू होता रहेगा, जब तक आप उसे रद्द नहीं करते।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
