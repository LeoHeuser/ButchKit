    "alert.paywall.subscriptionOverlap.message" : {
      "comment" : "Message of that alert. The app cannot cancel the subscription itself, so it explains why the user should.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
