    "error.paywall.purchaseFailed.message" : {
      "comment" : "Message of the alert after a purchase failed. 'Restore' is the paywall's restore button and must match its translation.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "لم يُفتح قفل أي شيء. حاول مرة أخرى. إذا تم خصم المبلغ بالفعل، فاستخدم «استعادة»."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Intet blev låst op. Prøv igen. Hvis du allerede er blevet opkrævet, skal du bruge “Gendan”."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Es wurde nichts freigeschaltet. Versuch es erneut. Falls dir bereits etwas berechnet wurde, tippe auf „Wiederherstellen“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Nothing was unlocked. Try again. If you were already charged, use Restore."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No se ha desbloqueado nada. Vuelve a intentarlo. Si ya se te ha cobrado, usa “Restaurar”."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mitään ei avattu. Yritä uudelleen. Jos sinua on jo veloitettu, valitse ”Palauta”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rien n’a été débloqué. Réessaie. Si tu as déjà été débité, utilise « Restaurer »."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "कुछ भी अनलॉक नहीं हुआ। फिर से कोशिश करें। अगर आपसे पहले ही शुल्क लिया जा चुका है, तो “रीस्टोर करें” का उपयोग करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tidak ada fitur yang dibuka. Coba lagi. Jika Anda sudah ditagih, gunakan “Pulihkan”."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Non è stato sbloccato nulla. Riprova. Se l’addebito è già avvenuto, usa “Ripristina”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "何もロック解除されませんでした。もう一度お試しください。すでに請求されている場合は、「復元」を使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "잠금 해제된 항목이 없습니다. 다시 시도하십시오. 이미 요금이 청구된 경우 '복원'을 사용하십시오."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tiada ciri yang dibuka kunci. Cuba lagi. Jika anda telah dicaj, gunakan “Pulihkan”."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Er is niets ontgrendeld. Probeer het opnieuw. Als er al kosten in rekening zijn gebracht, gebruik je ‘Herstel’."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nic nie zostało odblokowane. Spróbuj ponownie. Jeśli opłata została już pobrana, użyj opcji „Odtwórz”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nada foi desbloqueado. Tente novamente. Se você já foi cobrado, use “Restaurar”."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nada foi desbloqueado. Tente novamente. Se o valor já lhe foi cobrado, utilize “Restaurar”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ничего не разблокировано. Повторите попытку. Если оплата уже списана, нажмите «Восстановить»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Inget låstes upp. Försök igen. Om du redan har debiterats använder du ”Återställ”."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hiçbir şeyin kilidi açılmadı. Yeniden deneyin. Ücret zaten alındıysa “Geri Yükle” seçeneğini kullanın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Нічого не розблоковано. Спробуйте ще раз. Якщо оплату вже списано, натисніть «Відновити»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "未解锁任何内容。请重试。如果你已被扣款，请使用“恢复”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "未解鎖任何內容。請再試一次。若你已被扣款，請使用「回復」。"
          }
        }
      }
    },
