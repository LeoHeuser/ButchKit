#!/bin/zsh
# Starts a ButchKit release when a version branch such as 2.0.24 is merged into
# main, see README.md, "Releasing". Active once `git config core.hooksPath
# Scripts/git-hooks` is set in the clone.
#
# The hook only pushes main and starts the Release workflow. The workflow builds
# and tests on macOS and iOS, and tags only when both pass, so a red state never
# becomes a version. Xcode's merge is done in seconds rather than waiting for it.
#
# The branch name is read from the reflog entry the merge just wrote
# ("merge 2.0.24: Fast-forward"), because a fast-forward leaves no other trace
# of it. A pull writes "pull: ..." and is ignored.
#
# Xcode does not show hook output, so the outcome is posted as a notification.
# A hook cannot undo the merge: a branch with any other name stays merged, it
# is just not pushed and gets no release.

[[ $(git branch --show-current) == main ]] || exit 0
action=$(git reflog -1 --format=%gs)
[[ $action == "merge "* ]] || exit 0
branch=${${action#merge }%%:*}

# Xcode runs hooks without the login shell's PATH, where gh lives.
PATH="$PATH:/opt/homebrew/bin:/usr/local/bin"

notify() {
  osascript -e 'on run argv' -e 'display notification (item 2 of argv) with title (item 1 of argv)' -e 'end run' "$1" "$2"
}

if output=$({ Scripts/check-version.sh "$branch" \
  && git push origin main \
  && gh workflow run release.yml --ref main -f version="$branch" } 2>&1); then
  notify "ButchKit v$branch started" "Tagged once build and tests pass on GitHub."
else
  print -r -- "$output" >&2
  notify "No ButchKit release for $branch" "${output##*$'\n'}"
  exit 1
fi
